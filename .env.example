# Kotak Neo app -> Trade API -> your application: the access token shown there
NEO_ACCESS_TOKEN=your_api_access_token
# Registered mobile number and client code (UCC) used with TOTP login
NEO_MOBILE=+91XXXXXXXXXX
NEO_UCC=your_client_code
# Optional: your 6-digit MPIN. If unset, the login screen asks for it each day.
NEO_MPIN=

# Exchanges whose scrip masters are downloaded for search (once per day)
NEO_EXCHANGES=NSE,BSE,NFO,BFO

# Lot sizes enforced for index derivatives (orders must be whole lots)
NEO_LOT_SIZES=NIFTY:65,SENSEX:20

# Set to 1 to explore the UI with simulated data (no Kotak account needed)
NEO_MOCK=0

# 5001 so it can run next to Kite Terminal (port 5000) on the same server
PORT=5001
